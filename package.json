{
  "name": "sermon-processor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nrutman/sermon-processor.git"
  },
  "bin": {
    "sermon": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --vitest-plugin --deny-warnings .",
    "process": "tsx src/cli.ts process",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "avr-vad": "^1.0.10",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "music-metadata": "^11.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
