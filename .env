# Copy this file to .env.local and fill in values for your environment.
# Organization embedded in the MP3 album-artist and comment metadata.
SERMON_ORGANIZATION=
# Destination directory; ~ is expanded to the current user's home directory.
SERMON_OUTPUT_DIRECTORY=
# Output filename template. Must contain YYYY, MM, DD, and LAST.
SERMON_FILENAME_FORMAT=

# Optional local Whisper transcription enables semantic non-speech shortening.
# Install whisper.cpp, then configure a readable GGML model file.
# WHISPER_CLI_PATH=whisper-cli
# WHISPER_MODEL_PATH=~/Library/Application Support/sermon-processor/models/ggml-base.en.bin
# WHISPER_VAD_MODEL_PATH=~/Library/Application Support/sermon-processor/models/ggml-silero-v6.2.0.bin

# Planning Center Personal Access Token credentials.
PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_SECRET=
# Planning Center requires an identifying User-Agent such as App Name (email@example.com).
PLANNING_CENTER_USER_AGENT=
# Optional default Services Service Type ID; override with --service-type.
# PLANNING_CENTER_DEFAULT_SERVICE_TYPE_ID=

# WordPress Application Password credentials used to upload and publish sermons.
# Site-specific values belong in .env.local, not this committed template.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Exact hostname where WordPress exposes offloaded sermon media.
WORDPRESS_MEDIA_HOST=
