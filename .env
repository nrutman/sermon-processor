# Copy this file to .env.local and fill in values for your environment.
# Organization embedded in the MP3 album-artist and comment metadata.
SERMON_ORGANIZATION=
# Destination directory; ~ is expanded to the current user's home directory.
SERMON_OUTPUT_DIRECTORY=
# Output filename template. Must contain YYYY, MM, DD, and LAST.
SERMON_FILENAME_FORMAT=

# Planning Center Personal Access Token credentials.
PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_SECRET=
# Planning Center requires an identifying User-Agent such as App Name (email@example.com).
PLANNING_CENTER_USER_AGENT=
# Optional default Services Service Type ID; override with --service-type.
# PLANNING_CENTER_DEFAULT_SERVICE_TYPE_ID=
